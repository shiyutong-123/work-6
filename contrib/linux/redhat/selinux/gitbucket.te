module gitbucket 1.1;

require {
	type smtp_port_t;
	type tomcat_t;
	type tomcat_var_lib_t;
	type unreserved_port_t;
	type var_lib_t;

	class file { execute read write create delete getattr setattr lock append };
	class dir { read write create delete getattr setattr lock add_name remove_name search };
	class tcp_socket { name_bind };
	class tcp_socket { name_connect };
}

# allow tomcat to send emails
allow tomcat_t smtp_port_t:tcp_socket { name_connect };

# allow file executes, required during repo creation
allow tomcat_t tomcat_var_lib_t:file { execute };

# allow tomcat to serve repositories via SSH
allow tomcat_t unreserved_port_t:tcp_socket { name_bind };

# allow access to /var/lib/gitbucket
allow tomcat_t var_lib_t:dir { read write create delete getattr setattr lock add_name remove_name search };
allow tomcat_t var_lib_t:file { execute read write create delete getattr setattr lock append };
