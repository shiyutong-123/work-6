[Unit]
Description=GitBucket - GitHub clone written with Scala
Documentation=https://github.com/gitbucket/gitbucket
After=network.target

[Service]
Type=simple
User=gitbucket
Group=gitbucket
EnvironmentFile=/etc/sysconfig/gitbucket
WorkingDirectory=/usr/share/gitbucket
ExecStart=/usr/bin/java $GITBUCKET_JVM_OPTS -jar /usr/share/gitbucket/lib/gitbucket.war --host=${GITBUCKET_HOST:-0.0.0.0} --port=${GITBUCKET_PORT:-8080} --prefix=${GITBUCKET_PREFIX:}
Environment=GITBUCKET_HOME=/var/lib/gitbucket
RuntimeDirectory=gitbucket
LogsDirectory=gitbucket
Restart=on-failure
RestartSec=10
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
