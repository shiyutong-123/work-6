+# Authentication lock for high concurrency (optional)
+# Set to 'true' to enable per-repository locking during authentication checks.
+# This prevents race conditions when multiple concurrent requests access the same repository,
+# which can cause intermittent 403 errors under high load.
+# You can enable this via environment variable or Java system property:
+#   Environment variable: GITBUCKET_ENABLE_AUTH_LOCK=true
+#   Java system property: -Dgitbucket.enable_auth_lock=true
+# Or add to gitbucket.conf home directory's gitbucket.properties file:
+#   enable_auth_lock=true
+# Default: false
+
 # Directory where GitBucket is installed
 # Configuration is stored here:
 GITBUCKET_DIR=/usr/share/gitbucket
